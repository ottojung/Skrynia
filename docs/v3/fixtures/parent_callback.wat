(module
  (import "skrynia_v3_1" "read1" (func $read (param i32) (result i32)))
  (import "skrynia_v3_1" "write1" (func $write (param i32 i32) (result i32)))
  (import "skrynia_v3_1" "eval" (func $eval (param i64 i64 i32 i32 i32) (result i64)))
  (memory (export "memory") 1)
  (table (export "__indirect_function_table") 1 funcref)
  (global $output (mut i32) (i32.const 0))
  (func $handler (param $a i32) (param $b i64) (result i32)
    (call $write (global.get $output)
      (i32.add (local.get $a) (i32.wrap_i64 (local.get $b)))))
  (elem (i32.const 0) func $handler)
  (func (export "skrynia_main")
    (param $in i32) (param $out i32) (result i32)
    (local $byte i32) (local $len i32)
    (global.set $output (local.get $out))
    (block $done
      (loop $again
        (local.set $byte (call $read (local.get $in)))
        (br_if $done (i32.eq (local.get $byte) (i32.const -1)))
        (if (i32.lt_s (local.get $byte) (i32.const 0))
          (then (return (local.get $byte))))
        (i32.store8 (local.get $len) (local.get $byte))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))
        (br $again)))
    (i32.wrap_i64 (call $eval (i64.const 0)
      (i64.extend_i32_u (local.get $len)) (i32.const 0) (i32.const 0) (i32.const 0))))
)
