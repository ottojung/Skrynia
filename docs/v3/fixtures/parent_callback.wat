(module
  (import "skrynia" "open_ram" (func $ram (result i32)))
  (import "skrynia" "truncate" (func $size (param i32 i64) (result i32)))
  (import "skrynia" "read1" (func $read (param i32) (result i32)))
  (import "skrynia" "write1" (func $write (param i32 i32) (result i32)))
  (import "skrynia" "eval" (func $eval (param i64 i64 i32 i32 i32) (result i64)))
  (table (export "__indirect_function_table") 1 funcref)
  (global $output (mut i32) (i32.const 0))
  (func $handler (param $a i32) (param $b i64) (result i32)
    (call $write (global.get $output)
      (i32.add (local.get $a) (i32.wrap_i64 (local.get $b)))))
  (elem (i32.const 0) func $handler)
  (func (export "skrynia_main")
    (param $in i32) (param $out i32) (result i32)
    (local $fd i32) (local $byte i32) (local $len i64)
    (global.set $output (local.get $out))
    (local.set $fd (call $ram))
    (if (i32.lt_s (local.get $fd) (i32.const 0))
      (then (return (local.get $fd))))
    ;; This standalone demonstration owns its RAM; real concurrent programs
    ;; must coordinate their own allocations.
    (if (i32.ne (call $size (local.get $fd) (i64.const 4096)) (i32.const 0))
      (then (return (i32.const -5))))
    (block $done
      (loop $again
        (local.set $byte (call $read (local.get $in)))
        (br_if $done (i32.eq (local.get $byte) (i32.const -1)))
        (if (i32.lt_s (local.get $byte) (i32.const 0))
          (then (return (local.get $byte))))
        (if (i32.ne (call $write (local.get $fd) (local.get $byte)) (i32.const 0))
          (then (return (i32.const -7))))
        (local.set $len (i64.add (local.get $len) (i64.const 1)))
        (br $again)))
    (i32.wrap_i64 (call $eval (i64.const 0) (local.get $len)
      (i32.const 0) (i32.const 0) (i32.const 0))))
)
