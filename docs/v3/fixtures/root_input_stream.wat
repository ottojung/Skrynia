(module
  (import "skrynia" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "skrynia" "write" (func $write (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "skrynia_main")
    (param $input_fd i32) (param $output_fd i32)
    (result i32)
    (local $n i32)
    (local.set $n (call $read (local.get $input_fd) (i32.const 256) (i32.const 32)))
    (if (result i32) (i32.lt_s (local.get $n) (i32.const 0))
      (then (local.get $n))
      (else (if (result i32)
        (i32.eq (call $write (local.get $output_fd) (i32.const 256) (local.get $n))
                (local.get $n))
        (then (i32.const 0))
        (else (i32.const -5)))))
  )
)
