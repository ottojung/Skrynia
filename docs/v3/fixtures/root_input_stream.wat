(module
  (import "skrynia_v3_1" "read1" (func $read (param i32) (result i32)))
  (import "skrynia_v3_1" "write1" (func $write (param i32 i32) (result i32)))
  (func (export "skrynia_main")
    (param $input_fd i32) (param $output_fd i32) (result i32)
    (local $byte i32) (local $status i32)
    (loop $again
      (local.set $byte (call $read (local.get $input_fd)))
      (if (i32.eq (local.get $byte) (i32.const -1))
        (then (return (i32.const 0))))
      (if (i32.lt_s (local.get $byte) (i32.const 0))
        (then (return (local.get $byte))))
      (local.set $status (call $write (local.get $output_fd) (local.get $byte)))
      (if (i32.lt_s (local.get $status) (i32.const 0))
        (then (return (local.get $status))))
      (br $again))
    (i32.const 0))
)
