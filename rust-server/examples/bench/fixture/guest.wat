(module
  (import "skrynia" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "skrynia" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "skrynia" "open_disk" (func $open (param i32 i32 i32) (result i32)))
  (import "skrynia" "sync" (func $sync (param i32) (result i32)))
  (import "skrynia" "close" (func $close (param i32) (result i32)))
  (import "skrynia" "try_mutation_lock" (func $lock (result i32)))
  (import "skrynia" "release_mutation_lock" (func $unlock (result i32)))
  (memory (export "memory") 2)
  (data (i32.const 128) "bench.dat")
  (func (export "skrynia_main") (param $input i32) (param $output i32)
    (result i32) (local $kind i32) (local $fd i32) (local $n i32)
    (local $remaining i32)
    (if (i32.ne (call $read (local.get $input) (i32.const 0) (i32.const 1))
                (i32.const 1)) (then (return (i32.const -9))))
    (local.set $kind (i32.load8_u (i32.const 0)))
    (if (i32.ne (local.get $kind) (i32.const 78))
      (then (if (i32.ne (call $lock) (i32.const 1))
        (then (return (i32.const -9))))))
    (if (i32.and (i32.ne (local.get $kind) (i32.const 78))
                 (i32.ne (local.get $kind) (i32.const 87)))
      (then (return (i32.const -9))))
    (if (i32.eq (local.get $kind) (i32.const 87))
      (then
        (local.set $remaining (i32.const 4096))
        (loop $copy
          (local.set $n (call $read (local.get $input)
                  (i32.sub (i32.const 12288) (local.get $remaining))
                  (local.get $remaining)))
          (if (i32.le_s (local.get $n) (i32.const 0))
            (then (return (i32.const -9))))
          (local.set $remaining (i32.sub (local.get $remaining) (local.get $n)))
          (br_if $copy (i32.gt_s (local.get $remaining) (i32.const 0))))
        (local.set $fd (call $open (i32.const 128) (i32.const 9) (i32.const 22)))
        (if (i32.lt_s (local.get $fd) (i32.const 0))
          (then (return (local.get $fd))))
        (if (i32.ne (call $write (local.get $fd) (i32.const 8192)
                 (i32.const 4096)) (i32.const 4096))
          (then (return (i32.const -9))))
        (if (i32.ne (call $sync (local.get $fd)) (i32.const 0))
          (then (return (i32.const -9))))
        (drop (call $close (local.get $fd)))))
    (if (i32.ne (local.get $kind) (i32.const 78))
      (then (if (i32.ne (call $unlock) (i32.const 0))
        (then (return (i32.const -9))))))
    (if (i32.ne (call $write (local.get $output) (i32.const 0)
              (i32.const 1)) (i32.const 1))
      (then (return (i32.const -9))))
    (i32.const 0)))
