(module
  (import "skrynia_v3_1" "read" (func $read (param i32 i64 i64) (result i64)))
  (import "skrynia_v3_1" "write" (func $write (param i32 i64 i64) (result i64)))
  (import "skrynia_v3_1" "seek" (func $seek (param i32 i64) (result i64)))
  (import "skrynia_v3_1" "open_ram" (func $ram (result i32)))
  (import "skrynia_v3_1" "truncate" (func $truncate (param i32 i64) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 16) "abcdef")
  (func (export "skrynia_main") (param $in i32) (param $out i32) (result i32)
    (local $r i32)
    (if (i64.ne (call $read (local.get $in) (i64.const 65535) (i64.const 2)) (i64.const -7)) (then unreachable))
    (if (i64.ne (call $read (local.get $in) (i64.const -1) (i64.const 2)) (i64.const -6)) (then unreachable))
    (if (i64.ne (call $seek (local.get $in) (i64.const 0)) (i64.const 0)) (then unreachable))
    (if (i64.ne (call $read (local.get $in) (i64.const 65536) (i64.const 0)) (i64.const 0)) (then unreachable))
    (if (i64.ne (call $read (local.get $in) (i64.const 16) (i64.const 6)) (i64.const 3)) (then unreachable))
    (if (i64.ne (call $read (local.get $in) (i64.const 16) (i64.const 6)) (i64.const 0)) (then unreachable))
    (if (i64.ne (call $read (local.get $out) (i64.const 16) (i64.const 0)) (i64.const -4)) (then unreachable))
    (if (i64.ne (call $write (local.get $in) (i64.const 16) (i64.const 0)) (i64.const -4)) (then unreachable))
    (local.set $r (call $ram))
    (if (i32.ne (call $truncate (local.get $r) (i64.const 4)) (i32.const 0)) (then unreachable))
    (if (i64.ne (call $write (local.get $r) (i64.const 16) (i64.const 6)) (i64.const 4)) (then unreachable))
    (if (i64.ne (call $seek (local.get $r) (i64.const 0)) (i64.const 4)) (then unreachable))
    (if (i64.ne (call $write (local.get $r) (i64.const 16) (i64.const 1)) (i64.const -7)) (then unreachable))
    (if (i64.ne (call $seek (local.get $r) (i64.const -4)) (i64.const 0)) (then unreachable))
    (if (i64.ne (call $read (local.get $r) (i64.const 32) (i64.const 6)) (i64.const 4)) (then unreachable))
    (if (i64.ne (call $write (local.get $out) (i64.const 16) (i64.const 6)) (i64.const 6)) (then unreachable))
    (if (i64.ne (call $write (local.get $out) (i64.const 32) (i64.const 4)) (i64.const 4)) (then unreachable))
    (i32.const 0)))
