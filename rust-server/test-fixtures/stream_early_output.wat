(module
  (import "skrynia" "write" (func $w (param i32 i32 i32) (result i32)))
  (import "skrynia" "read" (func $r (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "AB")
  (func (export "skrynia_main") (param $in i32) (param $out i32)
    (result i32) (local $n i32)
    (drop (call $w (local.get $out) (i32.const 0) (i32.const 1)))
    (loop $input
      (local.set $n (call $r (local.get $in) (i32.const 256) (i32.const 32)))
      (if (i32.lt_s (local.get $n) (i32.const 0))
        (then (return (local.get $n))))
      (br_if $input (i32.gt_s (local.get $n) (i32.const 0))))
    (drop (call $w (local.get $out) (i32.const 1) (i32.const 1)))
    (i32.const 0)))
