(module
 (import "skrynia" "invoke" (func $invoke(param i32 i32 i32 i32)(result i32)))
 (import "skrynia" "read" (func $read(param i32 i32 i32)(result i32)))
 (import "skrynia" "write" (func $write(param i32 i32 i32)(result i32)))
 (memory(export "memory") 1)
 (data(i32.const 0) "SAFE")
 (data(i32.const 16) "LEAK")
 (func(export "skrynia_main")(param $in i32)(param $out i32)(result i32)
   (local $n i32)(local $fd i32)(local $rc i32)(local $src i32)
   (local.set $n(call $invoke(i32.const 32)(i32.const 0)(i32.const 128)(i32.const 4)))
   (if (i32.ne(local.get $n)(i32.const 4))
     (then(return(i32.const -5))))
   (local.set $fd(i32.load(i32.const 128)))
   (local.set $rc(call $read(local.get $fd)(i32.const 160)(i32.const 1)))
   (local.set $src (select (i32.const 0)(i32.const 16)
       (i32.eq(local.get $rc)(i32.const -7))))
   (if (i32.ne(call $write(local.get $out)(local.get $src)(i32.const 4))
       (i32.const 4))
     (then(return(i32.const -5))))
   (i32.const 0)))
