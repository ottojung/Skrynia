(module
 (import "skrynia" "open_disk" (func $open(param i64 i64 i32)(result i32)))
 (import "skrynia" "read" (func $read(param i32 i32 i32)(result i32)))
 (import "skrynia" "close" (func $close(param i32)(result i32)))
 (import "skrynia" "eval" (func $eval(param i32 i32 i32 i32 i32)(result i32)))
 (memory(export "memory") 2)
 (table(export "__indirect_function_table") 1 funcref)
 (data(i32.const 0) "private")
 (data(i32.const 32) "guest.wasm")
 (func $cb (param $rp i32)(param $rl i32)(param $dp i32)(param $dc i32)(result i32)
   (local $fd i32)(local $n i32)
   (local.set $fd(call $open (i64.const 0) (i64.const 7) (i32.const 1)))
   (if (i32.lt_s(local.get $fd)(i32.const 0))
     (then(return(local.get $fd))))
   (local.set $n(call $read(local.get $fd)(i32.const 2048)(i32.const 1)))
   (drop(call $close(local.get $fd)))
   (if (i32.ne(local.get $n)(i32.const 1))
     (then(return(i32.const -7))))
   (i32.store8(local.get $dp)(i32.load8_u(i32.const 2048)))
   (i32.const 1))
 (elem(i32.const 0) func $cb)
 (func(export "skrynia_main")(param $in i32)(param $out i32)(result i32)
   (local $fd i32)(local $n i32)
   (local.set $fd(call $open (i64.const 32) (i64.const 10) (i32.const 1)))
   (if (i32.lt_s(local.get $fd)(i32.const 0))
     (then(return(local.get $fd))))
   (local.set $n(call $read(local.get $fd)(i32.const 4096)(i32.const 8192)))
   (drop(call $close(local.get $fd)))
   (if (i32.le_s(local.get $n)(i32.const 0))
     (then(return(i32.const -5))))
   (call $eval(i32.const 4096)(local.get $n)
      (local.get $in)(local.get $out)(i32.const 0))))
