(module
  (import "skrynia" "read" (func $r (param i32 i32 i32) (result i32)))
  (import "skrynia" "write" (func $w (param i32 i32 i32) (result i32)))
  (memory (export "memory") 3)
  (func (export "skrynia_main") (param $in i32) (param $out i32)
    (result i32)
    (if (i32.ne (call $r (local.get $in) (i32.const 65537)
        (i32.const 131072)) (i32.const -8))
      (then (return (i32.const -9))))
    (if (i32.ne (call $r (local.get $in) (i32.const 0)
        (i32.const 131072)) (i32.const 65536))
      (then (return (i32.const -9))))
    (if (i32.ne (call $r (local.get $in) (i32.const 65536)
        (i32.const 65536)) (i32.const 65536))
      (then (return (i32.const -9))))
    (if (i32.ne (call $w (local.get $out) (i32.const 65537)
        (i32.const 131072)) (i32.const -8))
      (then (return (i32.const -9))))
    (if (i32.ne (call $w (local.get $out) (i32.const 0)
        (i32.const 131072)) (i32.const 65536))
      (then (return (i32.const -9))))
    (if (i32.ne (call $w (local.get $out) (i32.const 65536)
        (i32.const 65536)) (i32.const 65536))
      (then (return (i32.const -9))))
    (i32.const 0)))
