(module
  (import "skrynia" "read" (func $r (param i32 i32 i32) (result i32)))
  (import "skrynia" "write" (func $w (param i32 i32 i32) (result i32)))
  (import "skrynia" "seek" (func $s (param i32 i64) (result i32)))
  (import "skrynia" "truncate" (func $t (param i32 i64) (result i32)))
  (import "skrynia" "sync" (func $y (param i32) (result i32)))
  (import "skrynia" "close" (func $c (param i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "skrynia_main") (param $input i32) (param $output i32)
    (result i32)
    (if (i32.eq (local.get $input) (local.get $output))
      (then (return (i32.const -1))))
    (if (i32.ne (call $r (local.get $input) (i32.const -1) (i32.const 3))
        (i32.const -8)) (then (return (i32.const -9))))
    (if (i32.ne (call $r (local.get $input) (i32.const 0) (i32.const 3))
        (i32.const 3)) (then (return (i32.const -9))))
    (i32.store8 (i32.const 3)
      (call $w (local.get $input) (i32.const 0) (i32.const 1)))
    (i32.store8 (i32.const 4)
      (call $r (local.get $output) (i32.const 0) (i32.const 1)))
    (i32.store8 (i32.const 5)
      (call $s (local.get $input) (i64.const 0)))
    (i32.store8 (i32.const 6)
      (call $s (local.get $output) (i64.const 0)))
    (i32.store8 (i32.const 7)
      (call $t (local.get $output) (i64.const 0)))
    (i32.store8 (i32.const 8) (call $y (local.get $output)))
    (i32.store8 (i32.const 9)
      (call $t (local.get $input) (i64.const 0)))
    (i32.store8 (i32.const 10) (call $y (local.get $input)))
    (if (i32.ne (call $w (local.get $output) (i32.const -1) (i32.const 3))
        (i32.const -8)) (then (return (i32.const -9))))
    (if (i32.ne (call $w (local.get $output) (i32.const 0) (i32.const 11))
        (i32.const 11)) (then (return (i32.const -5))))
    (drop (call $c (local.get $output)))
    (if (i32.ne (call $w (local.get $output) (i32.const 0) (i32.const 1))
        (i32.const -7)) (then (return (i32.const -9))))
    (drop (call $c (local.get $input)))
    (if (i32.ne (call $r (local.get $input) (i32.const 0) (i32.const 1))
        (i32.const -7)) (then (return (i32.const -9))))
    (i32.const 0)))
