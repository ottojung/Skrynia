(module
  (import "skrynia" "open_disk" (func $open (param i32 i32 i32) (result i32)))
  (import "skrynia" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "skrynia" "close" (func $close (param i32) (result i32)))
  (import "skrynia" "eval" (func $eval (param i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 6)
  (data (i32.const 0) "security/program0.sha256")
  (data (i32.const 64) "programs/root.wasm")
  (func $rex (param $fd i32) (param $dst i32) (param $len i32) (result i32)
    (local $n i32) (local $o i32)
    (block $ok (loop $lp (br_if $ok (i32.ge_u (local.get $o) (local.get $len)))
      (local.set $n (call $read (local.get $fd) (i32.add (local.get $dst) (local.get $o)) (i32.sub (local.get $len) (local.get $o))))
      (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (i32.const -4))))
      (local.set $o (i32.add (local.get $o) (local.get $n))) (br $lp))) (i32.const 0))
  (func $auth (param $in i32) (result i32)
    (local $fd i32) (local $i i32)
    (if (i32.lt_s (call $rex (local.get $in) (i32.const 256) (i32.const 33)) (i32.const 0)) (then (return (i32.const -4))))
    (if (i32.ne (i32.load8_u (i32.const 256)) (i32.const 1)) (then (return (i32.const -4))))
    (local.set $fd (call $open (i32.const 0) (i32.const 24) (i32.const 1)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then (return (i32.const -4))))
    (if (i32.lt_s (call $rex (local.get $fd) (i32.const 320) (i32.const 32)) (i32.const 0)) (then (drop (call $close (local.get $fd))) (return (i32.const -4))))
    (if (i32.ne (call $read (local.get $fd) (i32.const 384) (i32.const 1)) (i32.const 0)) (then (drop (call $close (local.get $fd))) (return (i32.const -4))))
    (drop (call $close (local.get $fd)))
    (block $eq (loop $lp (br_if $eq (i32.ge_u (local.get $i) (i32.const 32)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 257) (local.get $i))) (i32.load8_u (i32.add (i32.const 320) (local.get $i)))) (then (return (i32.const -4))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $lp))) (i32.const 0))
  (func $load (result i32)
    (local $fd i32) (local $n i32) (local $o i32)
    (local.set $fd (call $open (i32.const 64) (i32.const 18) (i32.const 1)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then (return (i32.const -1))))
    (block $done (loop $lp
      (local.set $n (call $read (local.get $fd) (i32.add (i32.const 1024) (local.get $o)) (i32.const 65536)))
      (br_if $done (i32.eqz (local.get $n)))
      (if (i32.lt_s (local.get $n) (i32.const 0)) (then (drop (call $close (local.get $fd))) (return (local.get $n))))
      (local.set $o (i32.add (local.get $o) (local.get $n))) (br $lp)))
    (drop (call $close (local.get $fd))) (local.get $o))
  (func (export "skrynia_main") (param $in i32) (param $out i32) (result i32)
    (local $a i32) (local $len i32)
    (local.set $a (call $auth (local.get $in)))
    (if (i32.lt_s (local.get $a) (i32.const 0)) (then (return (local.get $a))))
    (local.set $len (call $load))
    (if (i32.le_s (local.get $len) (i32.const 0)) (then (return (i32.const -2))))
    (call $eval (i32.const 1024) (local.get $len) (local.get $in) (local.get $out) (i32.const -1)))
)
